# Copy to .env (git-ignored) for local bundles, or set these as CI secrets.
# Server baked into the bundled profile patch (omit to use http://127.0.0.1:8081).
NEXUSAI_BASE_URL=http://127.0.0.1:8081
# Login-payload decryption keys (must match the server's configuration).
NEXUSAI_AES_KEY=
NEXUSAI_AES_IV=
