<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron's V8 needs these two; electron-builder's own template ships
         the same pair. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for this bundle: the runtime under Contents/Resources carries
         third-party native libraries (sherpa-onnx, node-pty, ripgrep) that are
         not signed by the same team, and hardened runtime's library validation
         would otherwise refuse to load them and the app would die on launch.
         electron-builder only applies its default template for real
         identities, so it is spelled out here. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The shell spawns the bundled dsh (same framework) as a child process. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
  </dict>
</plist>
