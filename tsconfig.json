{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "client/**/*.ts", "client/**/*.tsx", "tests/**/*.ts"]
}
