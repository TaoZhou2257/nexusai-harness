# The plugin's `peerDependencies` are the dsh packages that host it at runtime —
# dsh's plugin registry supplies them, they are never installed here, and
# `scripts/build.mjs` deliberately keeps `@deepseek-ai/*` external. npm does not
# know that: `npm ci` resolves every peer against the registry and dies with
# ERESOLVE (the published dsh packages peer on mutually incompatible rc
# versions). Ignoring peer resolution is the honest setting for this package.
legacy-peer-deps=true
